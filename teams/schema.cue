package teams

// A product team and what the platform gives it. One file per team in this directory
// (`teams/<name>.cue`, `Teams: <name>: #Team & {...}`); a PR adding one onboards the team.
#Team: {
	// Not `system`: its Applications namespace would be Argo CD's own (argocd-system).
	name!: =~"^[a-z][a-z0-9]{1,20}$" & !="system"

	// The GitHub team (group name in the cluster's human identity: a placeholder until one exists).
	// It gets read access (`view`, which excludes Secrets) in the team's namespaces.
	group: *"homelab-selfuryon:\(name)" | string

	// Resource quotas of the long-lived environments (`<team>-staging`, `<team>-prod`) and of each
	// preview namespace (`<team>-pr-<n>`, generated by admission when Argo creates it).
	quota: {
		staging: #Quota
		prod:    #Quota
		preview: #Quota
	}

	// Source of the team's manifest artifacts: `oci://ghcr.io/homelab-selfuryon/<app>/manifests` of apps
	// named `<team>-*`. Argo CD matches the glob with `/` as separator, so `*` stays inside one path
	// segment and `/manifests` must be spelled out.
	sourceRepos: *["oci://ghcr.io/homelab-selfuryon/\(name)-*/manifests"] | [...string]

	// Names used by the render (and by the policies that restrict them).
	deployer:        "deployer"
	previewDeployer: "\(name)-preview-deployer"
	namespaces: {
		staging:        "\(name)-staging"
		prod:           "\(name)-prod"
		previewPattern: "\(name)-pr-*"
		previewRegex:   "^\(name)-pr-[0-9]+$"
		// The team's Argo CD Applications (staging, prod); preview ones stay in argocd-system.
		argocd: "argocd-\(name)"
	}
}

#Quota: {
	requestsCPU:            string
	requestsMemory:         string
	limitsMemory:           string
	pods:                   string
	persistentVolumeClaims: *"4" | string
	requestsStorage:        *"20Gi" | string
}

// Namespaced kinds an app render creates (platform-kit `#App`). Used for the team's deploy
// Role and the AppProject whitelist: nothing else can be deployed. No Secrets, no pods/exec,
// no RBAC objects.
#DeployKinds: [
	{group: "", resources: ["serviceaccounts", "services", "configmaps"], kinds: ["ServiceAccount", "Service", "ConfigMap"]},
	{group: "apps", resources: ["deployments"], kinds: ["Deployment"]},
	{group: "policy", resources: ["poddisruptionbudgets"], kinds: ["PodDisruptionBudget"]},
	{group: "gateway.networking.k8s.io", resources: ["httproutes"], kinds: ["HTTPRoute"]},
	{group: "cilium.io", resources: ["ciliumnetworkpolicies"], kinds: ["CiliumNetworkPolicy"]},
	{group: "postgresql.cnpg.io", resources: ["clusters"], kinds: ["Cluster"]},
	{group: "secrets-store.csi.x-k8s.io", resources: ["secretproviderclasses"], kinds: ["SecretProviderClass"]},
]

Teams: [string]~(Name,_): #Team & {name: Name}
