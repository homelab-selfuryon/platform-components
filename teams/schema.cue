package teams

// A product team and what the platform gives it. Which teams exist comes from the catalog
// (teams/catalog.cue); everything else here is the platform's: defaults for every team, and in
// teams/<name>.cue the values one team needs instead (unified with these defaults).
#Team: {
	// Not `system`: its Applications namespace would be Argo CD's own (argocd-system). A tenant team
	// of the catalog: values for a team the catalog does not have fail here.
	name!: =~"^[a-z][a-z0-9]{1,20}$" & !="system"

	// The GitHub team (group name in the cluster's human identity: a placeholder until one exists).
	// It gets read access (`view`, which excludes Secrets) in the team's namespaces.
	group: *"homelab-selfuryon:\(name)" | string

	// Resource quotas of the long-lived environments (`<team>-staging`, `<team>-prod`) and of each
	// preview namespace (`<team>-pr-<n>`, generated by admission when Argo creates it). A size gives
	// all of them; a team that needs a different value sets just that one, e.g.
	// `Teams: search: quota: prod: requestsCPU: "8"` in teams/search.cue.
	size: *"small" | "medium" | "large"
	quota: {
		for env, q in #Sizes[size] {
			(env): {for k, v in q {(k): *v | #Quantity}}
		}
	}

	// Source of the team's manifest artifacts: `oci://ghcr.io/homelab-selfuryon/<app>/manifests` of apps
	// named `<team>-*`. Argo CD matches the glob with `/` as separator, so `*` stays inside one path
	// segment and `/manifests` must be spelled out.
	sourceRepos: *["oci://ghcr.io/homelab-selfuryon/\(name)-*/manifests"] | [...string]

	// Names used by the render (and by the policies that restrict them).
	deployer:        "deployer"
	previewDeployer: "\(name)-preview-deployer"
	namespaces: {
		staging:        "\(name)-staging"
		prod:           "\(name)-prod"
		previewPattern: "\(name)-pr-*"
		previewRegex:   "^\(name)-pr-[0-9]+$"
		// The team's Argo CD Applications (staging, prod); preview ones stay in argocd-system.
		argocd: "argocd-\(name)"
	}
}

#Quantity: =~"^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti)?$"

#Quota: {
	requestsCPU:            #Quantity
	requestsMemory:         #Quantity
	limitsMemory:           #Quantity
	pods:                   #Quantity
	persistentVolumeClaims: #Quantity
	requestsStorage:        #Quantity
}

// Quota sizes per environment. `small` is what the notes team was onboarded with; medium doubles
// it, large doubles medium.
#Sizes: [string]: ["staging" | "prod" | "preview"]: #Quota
#Sizes: {
	small: {
		staging: {requestsCPU: "2", requestsMemory: "2Gi", limitsMemory: "4Gi", pods: "20", persistentVolumeClaims: "4", requestsStorage: "20Gi"}
		prod:    {requestsCPU: "4", requestsMemory: "4Gi", limitsMemory: "8Gi", pods: "30", persistentVolumeClaims: "4", requestsStorage: "20Gi"}
		preview: {requestsCPU: "500m", requestsMemory: "512Mi", limitsMemory: "1Gi", pods: "8", persistentVolumeClaims: "2", requestsStorage: "4Gi"}
	}
	medium: {
		staging: {requestsCPU: "4", requestsMemory: "4Gi", limitsMemory: "8Gi", pods: "40", persistentVolumeClaims: "8", requestsStorage: "40Gi"}
		prod:    {requestsCPU: "8", requestsMemory: "8Gi", limitsMemory: "16Gi", pods: "60", persistentVolumeClaims: "8", requestsStorage: "40Gi"}
		preview: {requestsCPU: "1", requestsMemory: "1Gi", limitsMemory: "2Gi", pods: "16", persistentVolumeClaims: "4", requestsStorage: "8Gi"}
	}
	large: {
		staging: {requestsCPU: "8", requestsMemory: "8Gi", limitsMemory: "16Gi", pods: "80", persistentVolumeClaims: "16", requestsStorage: "80Gi"}
		prod:    {requestsCPU: "16", requestsMemory: "16Gi", limitsMemory: "32Gi", pods: "120", persistentVolumeClaims: "16", requestsStorage: "80Gi"}
		preview: {requestsCPU: "2", requestsMemory: "2Gi", limitsMemory: "4Gi", pods: "32", persistentVolumeClaims: "8", requestsStorage: "16Gi"}
	}
}

// Namespaced kinds an app render creates (platform-kit `#App`). Used for the team's deploy
// Role and the AppProject whitelist: nothing else can be deployed. No Secrets, no pods/exec,
// no RBAC objects.
#DeployKinds: [
	{group: "", resources: ["serviceaccounts", "services", "configmaps"], kinds: ["ServiceAccount", "Service", "ConfigMap"]},
	{group: "apps", resources: ["deployments"], kinds: ["Deployment"]},
	{group: "policy", resources: ["poddisruptionbudgets"], kinds: ["PodDisruptionBudget"]},
	{group: "gateway.networking.k8s.io", resources: ["httproutes"], kinds: ["HTTPRoute"]},
	{group: "cilium.io", resources: ["ciliumnetworkpolicies"], kinds: ["CiliumNetworkPolicy"]},
	{group: "postgresql.cnpg.io", resources: ["clusters"], kinds: ["Cluster"]},
	{group: "secrets-store.csi.x-k8s.io", resources: ["secretproviderclasses"], kinds: ["SecretProviderClass"]},
]

Teams: [string]~(Name,_): #Team & {name: Name}
