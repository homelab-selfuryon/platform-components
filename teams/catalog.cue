@extern(embed)

// Which teams exist comes from the catalog: teams/catalog.json is generated by the `catalog`
// repository and arrives as a PR from it (meta delivery.md, "Catalog"); never edit it here. Every
// team with tenant namespaces becomes a component `team-<name>` with the platform's defaults
// (schema.cue). A team that needs something else gets it in its own teams/<name>.cue.
package teams

import "list"

_catalog: _ @embed(file="catalog.json")

// Tenant teams of the catalog: the only names Teams accepts.
_tenants: [for n, t in _catalog.teams if t.tenant {n}]

Teams: {for n in _tenants {(n): {}}}

// Values in teams/<name>.cue only for a tenant team of the catalog: a team removed from (or never
// in) the catalog fails here instead of becoming a team.
Teams: [string]~(N,_): {_inCatalog: list.Contains(_tenants, N) & true}
